# Base URL the RPC client uses to reach the Assay server.
# Default (unset) = "/api", which the Vite dev server proxies to the
# ASSAY_SERVER_URL below. Set this to talk to the server directly, e.g.
# when the UI is served same-origin by `assay` itself.
# VITE_ASSAY_BASE_URL=http://127.0.0.1:8080

# Where the dev-server proxy forwards "/api" requests.
# ASSAY_SERVER_URL=http://127.0.0.1:8080

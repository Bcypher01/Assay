# Assay environment template for local development and the data pipeline.
# Deployment (docker compose) uses a separate file: deploy/.env.example.
#
# Public venue data is fetched anonymously. The only credentials required are
# for publishing the generated bar library to Cloudflare R2.

# Public data sources
ASSAY_BINANCE_DATA_BASE_URL=https://data.binance.vision
ASSAY_DUKASCOPY_DATA_BASE_URL=https://datafeed.dukascopy.com
ASSAY_YAHOO_CHART_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart/
ASSAY_STOOQ_BASE_URL=https://stooq.com/q/d/l/
ASSAY_STOOQ_API_KEY=

# Pipeline run configuration
ASSAY_PUBLISHER=r2
ASSAY_BUILD_VERSION=dev
ASSAY_PIPELINE_SYMBOLS=BINANCE:BTCUSDT,BINANCE:ETHUSDT,DUKAS:EURUSD,DUKAS:GBPUSD,DUKAS:USDJPY,DUKAS:XAUUSD
ASSAY_PIPELINE_TFS=m15,m30,h1,h4,d1,w1
ASSAY_PIPELINE_FROM=2017-08-01
ASSAY_PIPELINE_TO=
ASSAY_LOCAL_PUBLISH_DIR=data/published
ASSAY_RECONCILE=true

# Cloudflare R2 publish target
ASSAY_R2_ACCOUNT_ID=
ASSAY_R2_ACCESS_KEY_ID=
ASSAY_R2_SECRET_ACCESS_KEY=
ASSAY_R2_BUCKET=assay-bars
ASSAY_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
ASSAY_R2_REGION=auto

# A domain whose DNS A/AAAA records point at this server.
ASSAY_DOMAIN=beta.example.com

# Used by Caddy to request and renew the TLS certificate.
ACME_EMAIL=you@example.com

# Optional public, read-only Parquet library. Leave blank to fetch directly
# from supported public venues.
ASSAY_LIBRARY_URL=https://data.example.com
